# Postgres (sobe com `docker compose up -d`)
DATABASE_URL="postgresql://kronos:kronos@localhost:5432/kronos?schema=public"

# Banco usado só pelos testes de integração (criado automaticamente pelo docker-compose)
TEST_DATABASE_URL="postgresql://kronos:kronos@localhost:5432/kronos_test?schema=public"

# HTTP
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# CORS — origem(s) do front-end, separadas por vírgula
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"

# Auth
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="12h"
COOKIE_NAME="kronos_session"

# Upload de imagens — disco local (padrão, bom pra dev)
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE_URL="http://localhost:3333/uploads"

# Upload de imagens — Cloudflare R2 (opcional). Se as cinco vierem preenchidas, o backend
# usa R2 em vez de disco local — necessário em produção, já que a maioria dos free tiers de
# hospedagem tem disco efêmero (some a cada deploy). Deixe em branco pra usar disco local.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""
